+/// qsd: an external hotspot host (the Decky backend brings up a Wi-Fi Direct group on a second interface so wlan0
+/// keeps its network). `up` returns (ssid, password, gateway, frequency); `down` releases one reference.
+pub type HotspotUp = std::sync::Arc<
+    dyn Fn() -> std::pin::Pin<
+            Box<dyn std::future::Future<Output = Result<(String, String, Ipv4Addr, i32), anyhow::Error>> + Send>,
+        > + Send
+        + Sync,
+>;
+pub type HotspotDown = std::sync::Arc<dyn Fn() + Send + Sync>;
+static HOTSPOT_PROVIDER: std::sync::OnceLock<(HotspotUp, HotspotDown)> = std::sync::OnceLock::new();
+
+pub fn set_hotspot_provider(up: HotspotUp, down: HotspotDown) {
+    let _ = HOTSPOT_PROVIDER.set((up, down));
+}
 /// Fixed listener port on the hotspot, so a firewall rule can be added once:
 /// `sudo firewall-cmd --zone=nm-shared --add-port=61812/tcp`
